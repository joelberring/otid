DATABASE_URL=postgresql://otid:otid@127.0.0.1:5433/otid
TEST_DATABASE_URL=postgresql://otid:otid@127.0.0.1:5433/otid_test
MINIO_ROOT_USER=otid-local
MINIO_ROOT_PASSWORD=replace-with-a-long-local-secret
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=otid-private
# Server-only configuration for the private, versioned map asset store. The
# values must never use NEXT_PUBLIC_ names or be sent to browsers.
OTID_MAP_STORE_ID=
OTID_MAP_STORE_ENDPOINT=
OTID_MAP_STORE_BUCKET=otid-private
OTID_MAP_STORE_REGION=us-east-1
OTID_MAP_STORE_ACCESS_KEY=
OTID_MAP_STORE_SECRET_KEY=
# Use loopback-development only with http://127.0.0.1; production requires HTTPS.
OTID_MAP_STORE_MODE=loopback-development
OTID_ROUTE_STORE_ID=
OTID_ROUTE_STORE_ENDPOINT=
OTID_ROUTE_STORE_BUCKET=otid-private
OTID_ROUTE_STORE_REGION=us-east-1
OTID_ROUTE_STORE_ACCESS_KEY=
OTID_ROUTE_STORE_SECRET_KEY=
OTID_ROUTE_STORE_MODE=loopback-development
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000
O_TID_PUBLIC_ORIGIN=http://127.0.0.1:3000
O_TID_SIMULATOR_MODE=
# Eventor (ADR-0170): masternyckel som krypterar klubbens API-nyckel. Bara serverns miljö,
# aldrig NEXT_PUBLIC_ och aldrig i databasens backup. Skapa med: openssl rand -base64 32
# Tom = Eventor är inte påslaget (appen startar ändå).
OTID_EVENTOR_MASTER_KEY=
# Endast test: basadress till en falsk Eventor. Lämna tom i drift (då används eventor.orientering.se).
OTID_EVENTOR_BASE_URL=
# E-post för återställningslänkar (ADR-0172). Tom OTID_SMTP_URL = ingen e-post; sidan "Glömt lösenordet"
# hänvisar då till den som driver O-Tid, som skapar en länk på /superadmin.
# smtp://användare:lösenord@värd:587 (STARTTLS) eller smtps://användare:lösenord@värd:465.
OTID_SMTP_URL=
OTID_MAIL_FROM="O-Tid <noreply@example.org>"
# Kontaktadress som visas på /integritet och "Glömt lösenordet" (valfri).
OTID_CONTACT_EMAIL=
# Registreringar per IP-adress och timme (förval 10). Webbläsartesterna höjer gränsen.
OTID_REGISTRATION_LIMIT_PER_HOUR=
# Radiokontroller (ADR-0172): endast test, basadress till en falsk ROC/OResults. Lämna tom i drift.
OTID_ROC_BASE_URL=
# off = den här instansen hämtar inga radiostämplingar (tom = hämtar; bara en instans åt gången).
OTID_RADIO_POLLER=
