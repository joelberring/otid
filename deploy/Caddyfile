# Automatisk HTTPS (Let's Encrypt) för OTID_DOMAIN. "localhost" ger ett lokalt certifikat.
{$OTID_DOMAIN} {
	encode zstd gzip
	# Steg 51: två webbinstanser (docs/lasttest.md). Färst pågående anrop (även öppna resultatströmmar); svarar inte en
	# instans prövas den andra i högst 5 s.
	reverse_proxy {$OTID_UPSTREAM:web:3000} {$OTID_UPSTREAM2:web2:3000} {
		lb_policy least_conn
		lb_try_duration 5s
		fail_duration 10s
	}
}
