# Automatisk HTTPS (Let's Encrypt) för OTID_DOMAIN. "localhost" ger ett lokalt certifikat.
{$OTID_DOMAIN} {
	encode zstd gzip

	# HSTS (ADR-0186): webbläsaren använder bara HTTPS mot domänen i ett år. Inte includeSubDomains eller preload, eftersom
	# OTID_DOMAIN kan vara klubbens egen domän med andra tjänster under sig.
	header Strict-Transport-Security "max-age=31536000"

	# Steg 59: kartfilens uppladdning (OCAD eller Mapper, högst 75 MB, plus bilden på högst 30 MB) är den enda stora bodyn.
	# Caddy har ingen gräns som standard; här står den uttryckligen så att den inte sänks av misstag. Appen kontrollerar
	# storleken igen innan något sparas (RACE_MAP_SOURCE_UPLOAD_MAX_BYTES).
	@mapsource path /api/admin/races/*/administrator/map/source
	request_body @mapsource {
		max_size 110MB
	}

	# ADR-0194: klubbarkivets kartfiler (importen från ägarens dator och en ny version i arkivet), högst 75 MB i appen
	# (CLUB_ARCHIVE_MAP_MAX_BYTES). ADR-0204: också importen i webbläsaren.
	@clubmaps path /api/club-import/*/content/* /api/organizer/clubs/*/maps /api/organizer/clubs/*/maps/* /api/organizer/clubs/*/import/content/*
	request_body @clubmaps {
		max_size 80MB
	}

	# ADR-0187: säkerhetskopian av en tävling (förhandsvisning och återställning), högst 200 MB i appen (RACE_BACKUP_MAX_BYTES).
	@restore path /api/organizer/restore /api/organizer/restore/preview
	request_body @restore {
		max_size 210MB
	}

	# ADR-0219 K6b: en DWG-ritning till geo-arbetaren, högst 75 MB i appen (GEO_DWG_MAX_BYTES).
	@geodwg path /api/organizer/map-projects/*/geo-jobs/dwg
	request_body @geodwg {
		max_size 80MB
	}

	# ADR-0219 K5: geo-arbetarens resultatfiler (bilden och kurvorna), högst 200 MB i appen (GEO_OUTPUT_MAX_BYTES).
	@geooutputs path /api/geo-worker/jobs/*/outputs/*
	request_body @geooutputs {
		max_size 210MB
	}

	# Statiska mediefiler som inte hör till appen, t.ex. introduktionsfilmen (NEXT_PUBLIC_INTRO_FILM_URL=/media/otid-intro.mp4).
	# Filerna läggs i ./media på servern (aldrig i git) och visas skrivskyddat; Range-anrop fungerar, så filmen kan spolas.
	handle_path /media/* {
		header Cache-Control "public, max-age=86400"
		root * /srv/media
		file_server
	}

	# Steg 54 (ADR-0177, docs/drift.md): tävlingen går före publiken. Två slags webbinstanser:
	# - web: arbetsytan, avläsningen, funktionärerna, inloggningen och admin-API:t (och allt för den som är inloggad),
	# - web-public och web-public2: publika sidor och API:er, Live och resultatströmmen för besökare utan inloggning.
	# Publika sökvägar utan sessionskaka går till web-public/web-public2 (färst pågående anrop, även öppna strömmar; svarar
	# en inte prövas den andra). Allt annat går till web.
	# ADR-0214: kartritarens länk (/kartfel/<nyckel> och /api/public/map-link/…) läses på web-public; svaren och beskeden
	# (/api/map-link/…) går till web, så att banläggningens ström når de öppna editorerna direkt.
	# Samma lista som PUBLIC_PATHS i apps/web/src/lib/public-paths.ts (testet kräver det). Ändras den: `dc restart caddy`.
	@public {
		path / /om /integritet /results /results/* /starts /starts/* /t/* /fest/* /g/* /kartfel/* /api/public/* /api/races/*/start-list /api/races/*/start-list/* /api/mcp /.well-known/* /_next/static/* /favicon.ico /icon.svg /apple-icon.png /manifest.webmanifest /icons/* /robots.txt
		not header_regexp Cookie (^|;\s*)(__Host-otid-organizer-session|otid_organizer_session)=
	}
	handle @public {
		reverse_proxy {$OTID_PUBLIC_UPSTREAM:web-public:3000} {$OTID_PUBLIC_UPSTREAM2:web-public2:3000} {
			lb_policy least_conn
			lb_try_duration 5s
			fail_duration 10s
		}
	}
	handle {
		reverse_proxy {$OTID_UPSTREAM:web:3000} {
			lb_try_duration 10s
		}
	}
}
