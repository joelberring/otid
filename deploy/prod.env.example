# Kopiera till .env i repots rot på servern: cp deploy/prod.env.example .env
# Domänen ska peka på serverns IP-adress (A/AAAA-post) innan start.
OTID_DOMAIN=tid.exempelklubb.se
# Långt slumpat lösenord, t.ex. från: openssl rand -base64 32
POSTGRES_PASSWORD=
# Eventor (valfritt): masternyckel som krypterar klubbens API-nyckel. Skapa med: openssl rand -base64 32
OTID_EVENTOR_MASTER_KEY=
# E-post (valfritt, ADR-0172): återställningslänk vid glömt lösenord. Utan OTID_SMTP_URL skapar superadmin länken.
# smtp://användare:lösenord@smtp.exempelklubb.se:587 (STARTTLS) eller smtps://…:465
OTID_SMTP_URL=
OTID_MAIL_FROM=O-Tid <noreply@exempelklubb.se>
# Hemlighet för spärrarnas hash av IP-adresser (valfri; tom = härleds ur databasens lösenord). openssl rand -base64 32
OTID_THROTTLE_SECRET=
# Kontaktadress som visas på sidan om personuppgifter (valfritt, förval otid@berring.se)
OTID_CONTACT_EMAIL=
# Logga in med Google (valfritt, ADR-0205): klienten från Google Cloud Console (docs/drift.md, Inloggning med Google).
# Återkomstadress: https://<OTID_DOMAIN>/api/account/google/callback. Båda tomma = ingen Google-knapp.
OTID_GOOGLE_CLIENT_ID=
OTID_GOOGLE_CLIENT_SECRET=
# Adress till introduktionsfilmen; länken "Se vad O-Tid kan (film, 1 min)" visas på startsidan bara när den är satt
NEXT_PUBLIC_INTRO_FILM_URL=
# ADR-0195, docs/drift.md (Uppdatera): version av de färdiga avbildningarna från ghcr.io. Tom = main (senaste gröna). En
# commit-sha (kort eller hel) låser versionen, t.ex. inför en tävling eller för att gå tillbaka.
OTID_TAG=
# ADR-0186, docs/drift.md. Databasroller: raderna OTID_DB_* läggs till av `sh deploy/db-roles.sh setup`; utan dem används
# superusern som förut.
# Krypterad kopia utanför servern (valfri): mål och lösenord för restic, t.ex. b2:<bucket>:otid med B2_ACCOUNT_ID/B2_ACCOUNT_KEY.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Bevakning (valfri, t.ex. healthchecks.io): backupen och hälsokontrollen pingar sina adresser, med /fail vid fel.
OTID_HEARTBEAT_BACKUP_URL=
OTID_HEARTBEAT_HEALTH_URL=
# Serverns veckorapport och larm till superadmin (ADR-0216, docs/drift.md, Serverrapport och larm). Allt har förval; tomt = förvalet.
# OTID_SERVER_REPORT=off / OTID_SERVER_ALERTS=off stänger av. Dag 1–7 (7 = söndag) och timme 0–23, svensk tid.
OTID_SERVER_REPORT_DAY=
OTID_SERVER_REPORT_HOUR=
# ADR-0219 K5, docs/drift.md (Geo-arbetaren): nyckeln som geo-arbetaren på geo-servern använder mot O-Tid (minst 32 tecken,
# openssl rand -hex 32). Tom = ingen geo-arbetare kan hämta jobb. Laserrutor per konto och månad (tom = 200).
OTID_GEO_WORKER_TOKEN=
OTID_GEO_TILES_PER_MONTH=
# ADR-0219 K5b, docs/drift.md (Geo-arbetaren): geo-servern hos Hetzner. Nyckeln skapas i Hetzners konsol (projektet → Säkerhet →
# API-tokens, Läs och skriv). Tom = ingen geo-server startas. Övriga har förval: typer cx23,cax11, platser fsn1,nbg1,hel1,
# tomgång 20 min, budget 10 €/månad, högst 8 timmar per server.
OTID_HETZNER_TOKEN=
OTID_GEO_SERVER_TYPES=
OTID_GEO_SERVER_LOCATIONS=
OTID_GEO_IDLE_MINUTES=
OTID_GEO_BUDGET_EUR_PER_MONTH=
# Kartprojekt (ADR-0219 K7): skriv nya versioner av OCAD-kartor (version 9+) genom att lappa filen. Av tills det är prövat i
# riktiga OCAD; 1 = på.
OTID_OCAD_WRITE=
