# Kopiera till .env i repots rot på servern: cp deploy/prod.env.example .env
# Domänen ska peka på serverns IP-adress (A/AAAA-post) innan start.
OTID_DOMAIN=tid.exempelklubb.se
# Långt slumpat lösenord, t.ex. från: openssl rand -base64 32
POSTGRES_PASSWORD=
# Eventor (valfritt): masternyckel som krypterar klubbens API-nyckel. Skapa med: openssl rand -base64 32
OTID_EVENTOR_MASTER_KEY=
