# Kopiera till .env i repots rot på servern: cp deploy/prod.env.example .env
# Domänen ska peka på serverns IP-adress (A/AAAA-post) innan start.
OTID_DOMAIN=tid.exempelklubb.se
# Långt slumpat lösenord, t.ex. från: openssl rand -base64 32
POSTGRES_PASSWORD=
# Eventor (valfritt): masternyckel som krypterar klubbens API-nyckel. Skapa med: openssl rand -base64 32
OTID_EVENTOR_MASTER_KEY=
# E-post (valfritt, ADR-0172): återställningslänk vid glömt lösenord. Utan OTID_SMTP_URL skapar superadmin länken.
# smtp://användare:lösenord@smtp.exempelklubb.se:587 (STARTTLS) eller smtps://…:465
OTID_SMTP_URL=
OTID_MAIL_FROM=O-Tid <noreply@exempelklubb.se>
# Hemlighet för spärrarnas hash av IP-adresser (valfri; tom = härleds ur databasens lösenord). openssl rand -base64 32
OTID_THROTTLE_SECRET=
# Kontaktadress som visas på sidan om personuppgifter (valfritt, förval otid@berring.se)
OTID_CONTACT_EMAIL=
# ADR-0186, docs/drift.md. Databasroller: raderna OTID_DB_* läggs till av `sh deploy/db-roles.sh setup`; utan dem används
# superusern som förut.
# Krypterad kopia utanför servern (valfri): mål och lösenord för restic, t.ex. b2:<bucket>:otid med B2_ACCOUNT_ID/B2_ACCOUNT_KEY.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Bevakning (valfri, t.ex. healthchecks.io): backupen och hälsokontrollen pingar sina adresser, med /fail vid fel.
OTID_HEARTBEAT_BACKUP_URL=
OTID_HEARTBEAT_HEALTH_URL=
