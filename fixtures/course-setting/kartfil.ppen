<?xml version="1.0" encoding="utf-8"?>
<!-- Steg 62: påhittad Purple Pen-fil till fixtures/maps/kartfil.omap (1:10 000), handskriven i Purple Pens format. Samma
     kontroller och mm som fixtures/iof/course-file-kartfil.xml. "Lång" har klassen H21 och en brytpunkt på sträckan 33–34;
     "Mellan" (D21) gafflar efter 31 (A: 32, B: 37) och möts vid 33. -->
<course-scribe-event>
  <event id="1">
    <title>Kvällsträning på kartfilen</title>
    <map kind="OCAD" scale="10000" ignore-missing-fonts="false">kartfil.omap</map>
    <all-controls print-scale="10000" description-kind="symbols" />
    <print-area automatic="true" restrict-to-page-size="true" left="-10" top="90" right="110" bottom="-10" page-width="827" page-height="1169" page-margins="0" page-landscape="false" />
    <numbering start="31" disallow-invertible="false" />
    <punch-card rows="3" columns="8" left-to-right="true" top-to-bottom="false" />
    <course-appearance />
    <descriptions lang="sv" color="black" />
    <ocad overprint-colors="false" />
  </event>
  <control id="1" kind="start">
    <location x="4" y="8" />
  </control>
  <control id="2" kind="normal">
    <code>31</code>
    <location x="15" y="42" />
    <description box="D" iof-2004-ref="1.3" />
  </control>
  <control id="3" kind="normal">
    <code>32</code>
    <location x="42" y="61" />
    <description box="D" iof-2004-ref="2.4" />
  </control>
  <control id="4" kind="normal">
    <code>33</code>
    <location x="76" y="52" />
  </control>
  <control id="5" kind="normal">
    <code>34</code>
    <location x="98" y="30" />
  </control>
  <control id="6" kind="normal">
    <code>35</code>
    <location x="82" y="9" />
  </control>
  <control id="7" kind="normal">
    <code>36</code>
    <location x="50" y="18" />
  </control>
  <control id="8" kind="normal">
    <code>37</code>
    <location x="26" y="76" />
  </control>
  <control id="9" kind="finish">
    <location x="12" y="4" />
    <description box="all" iof-2004-ref="14.3" />
  </control>
  <course id="1" kind="normal" order="1">
    <name>Lång</name>
    <secondary-title>H21</secondary-title>
    <labels label-kind="sequence" />
    <first course-control="1" />
    <print-area automatic="true" restrict-to-page-size="true" left="-10" top="90" right="110" bottom="-10" page-width="827" page-height="1169" page-margins="0" page-landscape="false" />
    <options print-scale="10000" description-kind="symbols" />
  </course>
  <course id="2" kind="normal" order="2">
    <name>Mellan</name>
    <secondary-title>D21</secondary-title>
    <labels label-kind="sequence" />
    <first course-control="11" />
    <print-area automatic="true" restrict-to-page-size="true" left="-10" top="90" right="110" bottom="-10" page-width="827" page-height="1169" page-margins="0" page-landscape="false" />
    <options print-scale="10000" description-kind="symbols" />
  </course>
  <course-control id="1" control="1">
    <next course-control="2" />
  </course-control>
  <course-control id="2" control="2">
    <next course-control="3" />
  </course-control>
  <course-control id="3" control="3">
    <next course-control="4" />
  </course-control>
  <course-control id="4" control="4">
    <next course-control="5" />
  </course-control>
  <course-control id="5" control="5">
    <next course-control="6" />
  </course-control>
  <course-control id="6" control="6">
    <next course-control="7" />
  </course-control>
  <course-control id="7" control="7">
    <next course-control="8" />
  </course-control>
  <course-control id="8" control="9" />
  <course-control id="11" control="1">
    <next course-control="12" />
  </course-control>
  <course-control id="12" control="2" variation="fork" variation-end="15">
    <next course-control="13" />
    <variation course-control="12" />
    <variation course-control="17" />
  </course-control>
  <course-control id="17" control="2" variation="fork" variation-end="15">
    <next course-control="18" />
    <variation course-control="12" />
    <variation course-control="17" />
  </course-control>
  <course-control id="13" control="3">
    <next course-control="15" />
  </course-control>
  <course-control id="18" control="8">
    <next course-control="15" />
  </course-control>
  <course-control id="15" control="4">
    <next course-control="16" />
  </course-control>
  <course-control id="16" control="7">
    <next course-control="19" />
  </course-control>
  <course-control id="19" control="9" />
  <leg id="1" start-control="4" end-control="5">
    <bends>
      <location x="92" y="48" />
    </bends>
  </leg>
</course-scribe-event>
