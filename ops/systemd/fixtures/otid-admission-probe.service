# Disposable Linux/systemd fixture only. Never install on an O-Tid deployment.
[Unit]
Description=O-Tid synthetic writer admission probe (not a production writer)
AssertPathExists=/run/o-tid-admission-probe/CONFIRMED_DISPOSABLE

[Service]
Type=oneshot
User=otid-writer
Group=otid-writer
WorkingDirectory=/opt/o-tid
Environment=PATH=/usr/bin:/bin
Environment=OTID_WRITER_STOP_PROFILE=systemd-v1
Environment=OTID_WRITER_STOP_FILE=/var/lib/o-tid/controller/closed
LoadCredential=database-url:/run/o-tid-admission-probe/database-url
ExecStart=/bin/sh /opt/o-tid/ops/systemd/writer-start.sh /usr/bin/true
StandardOutput=null
StandardError=null
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
