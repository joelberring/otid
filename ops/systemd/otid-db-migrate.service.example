# Example only: do not install/enable before TASK180 Linux acceptance.
[Unit]
Description=O-Tid controlled database migration writer (unverified example)

[Service]
Type=oneshot
User=otid-writer
Group=otid-writer
WorkingDirectory=/opt/o-tid
Environment=PATH=/usr/bin:/bin
Environment=OTID_WRITER_STOP_PROFILE=systemd-v1
Environment=OTID_WRITER_STOP_FILE=/var/lib/o-tid/controller/closed
LoadCredential=database-url:/etc/o-tid/writer-credentials/database-url
ExecStart=/bin/sh /opt/o-tid/ops/systemd/writer-start.sh /usr/bin/pnpm --filter @o-tid/database migrate
UMask=0077
NoNewPrivileges=true
ProtectHome=true
PrivateMounts=true
PrivateTmp=true
