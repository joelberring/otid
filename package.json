{
  "name": "o-tid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @o-tid/web dev",
    "lint": "pnpm -r lint && eslint tests/e2e scripts",
    "lint:dead": "knip",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests/e2e/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @o-tid/application test:integration",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @o-tid/database migrate",
    "archive-import": "pnpm --silent --filter @o-tid/club-archive archive-import",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "account:superadmin": "tsx --env-file-if-exists=.env scripts/account-superadmin.ts",
    "print:worker": "tsx --env-file-if-exists=.env scripts/print-worker.ts",
    "lasttest:seed": "tsx scripts/lasttest/seed.ts",
    "lasttest:load": "tsx scripts/lasttest/load.ts",
    "load-test": "tsx scripts/load-test.ts",
    "si:ports": "tsx apps/si-tools/src/cli.ts ports",
    "si:capture": "tsx apps/si-tools/src/cli.ts capture",
    "si:replay": "tsx apps/si-tools/src/cli.ts replay"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@o-tid/database": "workspace:*",
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "knip": "5.60.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  }
}
