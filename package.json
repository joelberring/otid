{
  "name": "o-tid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @o-tid/web dev",
    "lint": "pnpm -r lint && eslint tests/e2e",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @o-tid/application test:integration",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @o-tid/database migrate",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "station:credential:issue": "tsx scripts/station-credential.ts issue",
    "station:credential:rotate": "tsx scripts/station-credential.ts rotate",
    "station:credential:revoke": "tsx scripts/station-credential.ts revoke",
    "station:pairing:issue": "tsx scripts/station-pairing.ts issue",
    "station:pairing:revoke": "tsx scripts/station-pairing.ts revoke",
    "eventor:connection:create": "tsx scripts/eventor-connection.ts create",
    "eventor:connection:revoke": "tsx scripts/eventor-connection.ts revoke",
    "eventor:entry-import:grant:issue": "tsx scripts/eventor-entry-import-grant.ts issue",
    "eventor:entry-import:grant:revoke": "tsx scripts/eventor-entry-import-grant.ts revoke",
    "organizer:account": "tsx scripts/organizer-account-access.ts",
    "account:password-recovery": "tsx scripts/account-password-recovery-access.ts",
    "si:ports": "tsx apps/si-tools/src/cli.ts ports",
    "si:capture": "tsx apps/si-tools/src/cli.ts capture",
    "si:replay": "tsx apps/si-tools/src/cli.ts replay",
    "android:test": "pnpm --dir apps/station android:test",
    "android:lint": "pnpm --dir apps/station android:lint",
    "android:assemble": "pnpm --dir apps/station android:assemble",
    "participant:android:test": "pnpm --dir apps/participant android:test",
    "participant:android:lint": "pnpm --dir apps/participant android:lint",
    "participant:android:assemble": "pnpm --dir apps/participant android:assemble"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@o-tid/database": "workspace:*",
    "@playwright/test": "1.55.0",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  }
}
