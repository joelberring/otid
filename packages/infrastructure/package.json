{
  "name": "@o-tid/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./src/index.ts", "./map-object-store": "./src/map-object-store.ts", "./route-object-store": "./src/route-object-store.ts" },
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run --no-file-parallelism test/integration",
    "test:integration:minio": "vitest run --no-file-parallelism test/integration/pm-minio.test.ts",
    "test:integration:minio-route": "vitest run --no-file-parallelism test/integration/route-minio.test.ts",
    "test:integration:minio-transfer": "vitest run --no-file-parallelism test/integration/pm-transfer.test.ts",
    "test:integration:minio-scan": "vitest run --no-file-parallelism test/integration/pm-scan-iteration.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": { "@o-tid/contracts": "workspace:*", "minio": "8.0.7", "zod": "4.1.5" },
  "devDependencies": { "@o-tid/application": "workspace:*", "@o-tid/database": "workspace:*", "drizzle-orm": "0.44.5" }
}
